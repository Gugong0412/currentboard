digraph G {
graph [rankdir=LR,bgcolor="white",pad=.25,nodesep=.2,ranksep=.7,splines=polyline,outputorder=edgesfirst,fontname="Arial"];
node [fontname="Arial",fontsize=12,shape=plain]; edge [arrowhead=none,color="#839da8",penwidth=1.2];
"U700" [id="part-U700",class="component",tooltip="B7_VDDI_DIG / IC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2f2f2" COLSPAN="2"><B>U700 · INA228AIDGSR</B></TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">A1</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">A0</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">ALERT</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SDA</TD></TR><TR><TD PORT="p5" ALIGN="LEFT">5</TD><TD ALIGN="LEFT">SCL</TD></TR><TR><TD PORT="p6" ALIGN="LEFT">6</TD><TD ALIGN="LEFT">VS</TD></TR><TR><TD PORT="p7" ALIGN="LEFT">7</TD><TD ALIGN="LEFT">GND</TD></TR><TR><TD PORT="p8" ALIGN="LEFT">8</TD><TD ALIGN="LEFT">VBUS</TD></TR><TR><TD PORT="p9" ALIGN="LEFT">9</TD><TD ALIGN="LEFT">IN_MINUS</TD></TR><TR><TD PORT="p10" ALIGN="LEFT">10</TD><TD ALIGN="LEFT">IN_PLUS</TD></TR></TABLE>>];
"R700" [id="part-R700",class="component",tooltip="B7_VDDI_DIG / 입력 필터 직렬 패드 P",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R700 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R701" [id="part-R701",class="component",tooltip="B7_VDDI_DIG / 입력 필터 직렬 패드 N",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R701 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R702" [id="part-R702",class="component",tooltip="B7_VDDI_DIG / ALERT pull-up",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R702 · 4.7k</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C700" [id="part-C700",class="component",tooltip="B7_VDDI_DIG / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C700 · 100n</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C701" [id="part-C701",class="component",tooltip="B7_VDDI_DIG / 차동 입력 필터 옵션",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#fff0d5"><B>C701 · 1n · DNP</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C702" [id="part-C702",class="component",tooltip="B7_VDDI_DIG / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C702 · 1u</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R708" [id="part-R708",class="component",tooltip="B7_VDDI_DIG / I2C1 단일 pull-up",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R708 · 2.2k</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R709" [id="part-R709",class="component",tooltip="B7_VDDI_DIG / I2C1 단일 pull-up",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R709 · 2.2k</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R507" [id="part-R507",class="component",tooltip="B5_DIG / Kelvin 션트",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f1f5f8" COLSPAN="2"><B>R507 · 20R</B></TD></TR><TR><TD COLSPAN="2">1↔3 / 2↔4 copper; 1–2 resistor</TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">FORCE_SRC</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">FORCE_DUT</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">SENSE_SRC</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SENSE_DUT</TD></TR></TABLE>>];
"n105" [id="n105",class="net",shape=box,style="rounded,filled",fillcolor="#d9e7f7",color="#8fa9ad",fontcolor="#28536a",label="GND",tooltip="GND"];
"n105" -> "U700":p1 [id="edge-U700-1",class="wire n105",tooltip="U700.1 = GND",style="solid"];
"n105" -> "U700":p2 [id="edge-U700-2",class="wire n105",tooltip="U700.2 = GND",style="solid"];
"n105" -> "U700":p7 [id="edge-U700-7",class="wire n105",tooltip="U700.7 = GND",style="solid"];
