"n151" [id="n151",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_DIG_DUT",tooltip="VDDI_DIG_DUT"];
"R507":p2 -> "n151" [id="edge-R507-2",class="wire n151",tooltip="R507.2 = VDDI_DIG_DUT",style="solid"];
{rank=sink;"U700";}
"n154" -> "n153" [constraint=false,style=dashed,color="#b37b18",label="R507 copper 1/3",fontsize=9];
"n151" -> "n152" [constraint=false,style=dashed,color="#b37b18",label="R507 copper 2/4",fontsize=9];
}