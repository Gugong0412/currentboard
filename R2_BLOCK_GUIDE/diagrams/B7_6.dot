"n152" [id="n152",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_DIG_SNS_DUT",tooltip="VDDI_DIG_SNS_DUT"];
"R701":p1 -> "n152" [id="edge-R701-1",class="wire n152",tooltip="R701.1 = VDDI_DIG_SNS_DUT",style="solid"];
