"n153" [id="n153",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_DIG_SNS_SRC",tooltip="VDDI_DIG_SNS_SRC"];
"R700":p1 -> "n153" [id="edge-R700-1",class="wire n153",tooltip="R700.1 = VDDI_DIG_SNS_SRC",style="solid"];
