"C702":p2 -> "n105" [id="edge-C702-2",class="wire n105",tooltip="C702.2 = GND",style="solid"];
"n75" [id="n75",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="ALERT_VDDI_DIG_N",tooltip="ALERT_VDDI_DIG_N"];
"n75" -> "U700":p3 [id="edge-U700-3",class="wire n75",tooltip="U700.3 = ALERT_VDDI_DIG_N",style="solid"];
"R702":p2 -> "n75" [id="edge-R702-2",class="wire n75",tooltip="R702.2 = ALERT_VDDI_DIG_N",style="solid"];
"n110" [id="n110",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="I2C1_SDA",tooltip="I2C1_SDA"];
"n110" -> "U700":p4 [id="edge-U700-4",class="wire n110",tooltip="U700.4 = I2C1_SDA",style="solid"];
"R708":p2 -> "n110" [id="edge-R708-2",class="wire n110",tooltip="R708.2 = I2C1_SDA",style="solid"];
"n109" [id="n109",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="I2C1_SCL",tooltip="I2C1_SCL"];
"n109" -> "U700":p5 [id="edge-U700-5",class="wire n109",tooltip="U700.5 = I2C1_SCL",style="solid"];
"R709":p2 -> "n109" [id="edge-R709-2",class="wire n109",tooltip="R709.2 = I2C1_SCL",style="solid"];
"n95" [id="n95",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="CTRL_3V3",tooltip="CTRL_3V3"];
"n95" -> "U700":p6 [id="edge-U700-6",class="wire n95",tooltip="U700.6 = CTRL_3V3",style="solid"];
"R702":p1 -> "n95" [id="edge-R702-1",class="wire n95",tooltip="R702.1 = CTRL_3V3",style="solid"];
"C700":p1 -> "n95" [id="edge-C700-1",class="wire n95",tooltip="C700.1 = CTRL_3V3",style="solid"];
"C702":p1 -> "n95" [id="edge-C702-1",class="wire n95",tooltip="C702.1 = CTRL_3V3",style="solid"];
"R708":p1 -> "n95" [id="edge-R708-1",class="wire n95",tooltip="R708.1 = CTRL_3V3",style="solid"];
"R709":p1 -> "n95" [id="edge-R709-1",class="wire n95",tooltip="R709.1 = CTRL_3V3",style="solid"];
"n154" [id="n154",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_DIG_SRC",tooltip="VDDI_DIG_SRC"];
"n154" -> "U700":p8 [id="edge-U700-8",class="wire n154",tooltip="U700.8 = VDDI_DIG_SRC",style="solid"];
"R507":p1 -> "n154" [id="edge-R507-1",class="wire n154",tooltip="R507.1 = VDDI_DIG_SRC",style="solid"];
"n57" [id="n57",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_DIG_INA_N",tooltip="/B7_VDDI_DIG/VDDI_DIG_INA_N"];
"n57" -> "U700":p9 [id="edge-U700-9",class="wire n57",tooltip="U700.9 = /B7_VDDI_DIG/VDDI_DIG_INA_N",style="solid"];
"R701":p2 -> "n57" [id="edge-R701-2",class="wire n57",tooltip="R701.2 = /B7_VDDI_DIG/VDDI_DIG_INA_N",style="solid"];
"C701":p2 -> "n57" [id="edge-C701-2",class="wire n57",tooltip="C701.2 = /B7_VDDI_DIG/VDDI_DIG_INA_N",style="dashed"];
"n58" [id="n58",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_DIG_INA_P",tooltip="/B7_VDDI_DIG/VDDI_DIG_INA_P"];
"n58" -> "U700":p10 [id="edge-U700-10",class="wire n58",tooltip="U700.10 = /B7_VDDI_DIG/VDDI_DIG_INA_P",style="solid"];
