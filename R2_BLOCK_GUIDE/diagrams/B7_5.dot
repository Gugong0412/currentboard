"C712":p1 -> "n95" [id="edge-C712-1",class="wire n95",tooltip="C712.1 = CTRL_3V3",style="solid"];
"n77" [id="n77",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="ALERT_VDDI_N",tooltip="ALERT_VDDI_N"];
"n77" -> "U710":p3 [id="edge-U710-3",class="wire n77",tooltip="U710.3 = ALERT_VDDI_N",style="solid"];
"R712":p2 -> "n77" [id="edge-R712-2",class="wire n77",tooltip="R712.2 = ALERT_VDDI_N",style="solid"];
"n110" [id="n110",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="I2C1_SDA",tooltip="I2C1_SDA"];
"n110" -> "U710":p4 [id="edge-U710-4",class="wire n110",tooltip="U710.4 = I2C1_SDA",style="solid"];
"n109" [id="n109",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="I2C1_SCL",tooltip="I2C1_SCL"];
"n109" -> "U710":p5 [id="edge-U710-5",class="wire n109",tooltip="U710.5 = I2C1_SCL",style="solid"];
"n164" [id="n164",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_SRC",tooltip="VDDI_SRC"];
"n164" -> "U710":p8 [id="edge-U710-8",class="wire n164",tooltip="U710.8 = VDDI_SRC",style="solid"];
"R527":p1 -> "n164" [id="edge-R527-1",class="wire n164",tooltip="R527.1 = VDDI_SRC",style="solid"];
"n55" [id="n55",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_INA_N",tooltip="/B7_VDDI/VDDI_INA_N"];
"n55" -> "U710":p9 [id="edge-U710-9",class="wire n55",tooltip="U710.9 = /B7_VDDI/VDDI_INA_N",style="solid"];
"R711":p2 -> "n55" [id="edge-R711-2",class="wire n55",tooltip="R711.2 = /B7_VDDI/VDDI_INA_N",style="solid"];
"C711":p2 -> "n55" [id="edge-C711-2",class="wire n55",tooltip="C711.2 = /B7_VDDI/VDDI_INA_N",style="dashed"];
"n56" [id="n56",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_INA_P",tooltip="/B7_VDDI/VDDI_INA_P"];
"n56" -> "U710":p10 [id="edge-U710-10",class="wire n56",tooltip="U710.10 = /B7_VDDI/VDDI_INA_P",style="solid"];
"R710":p2 -> "n56" [id="edge-R710-2",class="wire n56",tooltip="R710.2 = /B7_VDDI/VDDI_INA_P",style="solid"];
"C711":p1 -> "n56" [id="edge-C711-1",class="wire n56",tooltip="C711.1 = /B7_VDDI/VDDI_INA_P",style="dashed"];
"n163" [id="n163",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_SNS_SRC",tooltip="VDDI_SNS_SRC"];
"R710":p1 -> "n163" [id="edge-R710-1",class="wire n163",tooltip="R710.1 = VDDI_SNS_SRC",style="solid"];
"R527":p3 -> "n163" [id="edge-R527-3",class="wire n163",tooltip="R527.3 = VDDI_SNS_SRC",style="solid"];
"n162" [id="n162",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_SNS_DUT",tooltip="VDDI_SNS_DUT"];
"R711":p1 -> "n162" [id="edge-R711-1",class="wire n162",tooltip="R711.1 = VDDI_SNS_DUT",style="solid"];
"R527":p4 -> "n162" [id="edge-R527-4",class="wire n162",tooltip="R527.4 = VDDI_SNS_DUT",style="solid"];
"n155" [id="n155",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_DUT",tooltip="VDDI_DUT"];
"R527":p2 -> "n155" [id="edge-R527-2",class="wire n155",tooltip="R527.2 = VDDI_DUT",style="solid"];
{rank=sink;"U710";}
"n164" -> "n163" [constraint=false,style=dashed,color="#b37b18",label="R527 copper 1/3",fontsize=9];
"n155" -> "n162" [constraint=false,style=dashed,color="#b37b18",label="R527 copper 2/4",fontsize=9];
}