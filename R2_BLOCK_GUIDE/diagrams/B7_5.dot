digraph G {
graph [rankdir=LR,bgcolor="white",pad=.25,nodesep=.2,ranksep=.7,splines=polyline,outputorder=edgesfirst,fontname="Arial"];
node [fontname="Arial",fontsize=12,shape=plain]; edge [arrowhead=none,color="#839da8",penwidth=1.2];
"U710" [id="part-U710",class="component",tooltip="B7_VDDI / IC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2f2f2" COLSPAN="2"><B>U710 · INA228AIDGSR</B></TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">A1</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">A0</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">ALERT</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SDA</TD></TR><TR><TD PORT="p5" ALIGN="LEFT">5</TD><TD ALIGN="LEFT">SCL</TD></TR><TR><TD PORT="p6" ALIGN="LEFT">6</TD><TD ALIGN="LEFT">VS</TD></TR><TR><TD PORT="p7" ALIGN="LEFT">7</TD><TD ALIGN="LEFT">GND</TD></TR><TR><TD PORT="p8" ALIGN="LEFT">8</TD><TD ALIGN="LEFT">VBUS</TD></TR><TR><TD PORT="p9" ALIGN="LEFT">9</TD><TD ALIGN="LEFT">IN_MINUS</TD></TR><TR><TD PORT="p10" ALIGN="LEFT">10</TD><TD ALIGN="LEFT">IN_PLUS</TD></TR></TABLE>>];
"R710" [id="part-R710",class="component",tooltip="B7_VDDI / 입력 필터 직렬 패드 P",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R710 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R711" [id="part-R711",class="component",tooltip="B7_VDDI / 입력 필터 직렬 패드 N",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R711 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R712" [id="part-R712",class="component",tooltip="B7_VDDI / ALERT pull-up",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R712 · 10k</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C710" [id="part-C710",class="component",tooltip="B7_VDDI / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C710 · 100n</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C711" [id="part-C711",class="component",tooltip="B7_VDDI / 차동 입력 필터 옵션",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#fff0d5"><B>C711 · 1n · DNP</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C712" [id="part-C712",class="component",tooltip="B7_VDDI / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C712 · 1u</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R527" [id="part-R527",class="component",tooltip="B5_VDDI / Kelvin 션트",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f1f5f8" COLSPAN="2"><B>R527 · 20R</B></TD></TR><TR><TD COLSPAN="2">1↔3 / 2↔4 copper; 1–2 resistor</TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">FORCE_SRC</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">FORCE_DUT</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">SENSE_SRC</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SENSE_DUT</TD></TR></TABLE>>];
"n105" [id="n105",class="net",shape=box,style="rounded,filled",fillcolor="#d9e7f7",color="#8fa9ad",fontcolor="#28536a",label="GND",tooltip="GND"];
"n105" -> "U710":p1 [id="edge-U710-1",class="wire n105",tooltip="U710.1 = GND",style="solid"];
"n105" -> "U710":p7 [id="edge-U710-7",class="wire n105",tooltip="U710.7 = GND",style="solid"];
"C710":p2 -> "n105" [id="edge-C710-2",class="wire n105",tooltip="C710.2 = GND",style="solid"];
"C712":p2 -> "n105" [id="edge-C712-2",class="wire n105",tooltip="C712.2 = GND",style="solid"];
"n95" [id="n95",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="CTRL_3V3",tooltip="CTRL_3V3"];
"n95" -> "U710":p2 [id="edge-U710-2",class="wire n95",tooltip="U710.2 = CTRL_3V3",style="solid"];
"n95" -> "U710":p6 [id="edge-U710-6",class="wire n95",tooltip="U710.6 = CTRL_3V3",style="solid"];
"R712":p1 -> "n95" [id="edge-R712-1",class="wire n95",tooltip="R712.1 = CTRL_3V3",style="solid"];
