"C721":p2 -> "n53" [id="edge-C721-2",class="wire n53",tooltip="C721.2 = /B7_VCI/VCI_INA_N",style="dashed"];
"n54" [id="n54",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VCI_INA_P",tooltip="/B7_VCI/VCI_INA_P"];
"n54" -> "U720":p10 [id="edge-U720-10",class="wire n54",tooltip="U720.10 = /B7_VCI/VCI_INA_P",style="solid"];
