"C722":p1 -> "n95" [id="edge-C722-1",class="wire n95",tooltip="C722.1 = CTRL_3V3",style="solid"];
"n149" [id="n149",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VCI_SRC",tooltip="VCI_SRC"];
"n149" -> "U720":p8 [id="edge-U720-8",class="wire n149",tooltip="U720.8 = VCI_SRC",style="solid"];
"R547":p1 -> "n149" [id="edge-R547-1",class="wire n149",tooltip="R547.1 = VCI_SRC",style="solid"];
"n53" [id="n53",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VCI_INA_N",tooltip="/B7_VCI/VCI_INA_N"];
"n53" -> "U720":p9 [id="edge-U720-9",class="wire n53",tooltip="U720.9 = /B7_VCI/VCI_INA_N",style="solid"];
