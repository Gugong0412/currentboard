digraph G {
graph [rankdir=LR,bgcolor="white",pad=.25,nodesep=.2,ranksep=.7,splines=polyline,outputorder=edgesfirst,fontname="Arial"];
node [fontname="Arial",fontsize=12,shape=plain]; edge [arrowhead=none,color="#839da8",penwidth=1.2];
"U720" [id="part-U720",class="component",tooltip="B7_VCI / IC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2f2f2" COLSPAN="2"><B>U720 · INA228AIDGSR</B></TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">A1</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">A0</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">ALERT</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SDA</TD></TR><TR><TD PORT="p5" ALIGN="LEFT">5</TD><TD ALIGN="LEFT">SCL</TD></TR><TR><TD PORT="p6" ALIGN="LEFT">6</TD><TD ALIGN="LEFT">VS</TD></TR><TR><TD PORT="p7" ALIGN="LEFT">7</TD><TD ALIGN="LEFT">GND</TD></TR><TR><TD PORT="p8" ALIGN="LEFT">8</TD><TD ALIGN="LEFT">VBUS</TD></TR><TR><TD PORT="p9" ALIGN="LEFT">9</TD><TD ALIGN="LEFT">IN_MINUS</TD></TR><TR><TD PORT="p10" ALIGN="LEFT">10</TD><TD ALIGN="LEFT">IN_PLUS</TD></TR></TABLE>>];
"R720" [id="part-R720",class="component",tooltip="B7_VCI / 입력 필터 직렬 패드 P",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R720 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R721" [id="part-R721",class="component",tooltip="B7_VCI / 입력 필터 직렬 패드 N",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R721 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R722" [id="part-R722",class="component",tooltip="B7_VCI / ALERT pull-up",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R722 · 10k</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C720" [id="part-C720",class="component",tooltip="B7_VCI / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C720 · 100n</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C721" [id="part-C721",class="component",tooltip="B7_VCI / 차동 입력 필터 옵션",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#fff0d5"><B>C721 · 1n · DNP</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C722" [id="part-C722",class="component",tooltip="B7_VCI / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C722 · 1u</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R547" [id="part-R547",class="component",tooltip="B5_VCI / Kelvin 션트",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f1f5f8" COLSPAN="2"><B>R547 · 100R</B></TD></TR><TR><TD COLSPAN="2">1↔3 / 2↔4 copper; 1–2 resistor</TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">FORCE_SRC</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">FORCE_DUT</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">SENSE_SRC</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SENSE_DUT</TD></TR></TABLE>>];
