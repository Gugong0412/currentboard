"C721":p1 -> "n54" [id="edge-C721-1",class="wire n54",tooltip="C721.1 = /B7_VCI/VCI_INA_P",style="dashed"];
"n148" [id="n148",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VCI_SNS_SRC",tooltip="VCI_SNS_SRC"];
