"n106" -> "U810":p9 [id="edge-U810-9",class="wire n106",tooltip="U810.9 = GND_F",style="solid"];
"C810":p2 -> "n106" [id="edge-C810-2",class="wire n106",tooltip="C810.2 = GND_F",style="solid"];
"C811":p2 -> "n106" [id="edge-C811-2",class="wire n106",tooltip="C811.2 = GND_F",style="solid"];
"C812":p2 -> "n106" [id="edge-C812-2",class="wire n106",tooltip="C812.2 = GND_F",style="solid"];
"C813":p2 -> "n106" [id="edge-C813-2",class="wire n106",tooltip="C813.2 = GND_F",style="solid"];
"n134" [id="n134",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="RAW_5V_F",tooltip="RAW_5V_F"];
"n134" -> "U800":p4 [id="edge-U800-4",class="wire n134",tooltip="U800.4 = RAW_5V_F",style="solid"];
"R800":p1 -> "n134" [id="edge-R800-1",class="wire n134",tooltip="R800.1 = RAW_5V_F",style="solid"];
"n134" -> "U810":p5 [id="edge-U810-5",class="wire n134",tooltip="U810.5 = RAW_5V_F",style="solid"];
"n134" -> "U810":p8 [id="edge-U810-8",class="wire n134",tooltip="U810.8 = RAW_5V_F",style="solid"];
"C810":p1 -> "n134" [id="edge-C810-1",class="wire n134",tooltip="C810.1 = RAW_5V_F",style="solid"];
"C811":p1 -> "n134" [id="edge-C811-1",class="wire n134",tooltip="C811.1 = RAW_5V_F",style="solid"];
"n178" [id="n178",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VGL_SRC",tooltip="VGL_SRC"];
