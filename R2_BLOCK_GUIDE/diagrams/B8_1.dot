digraph G {
graph [rankdir=LR,bgcolor="white",pad=.25,nodesep=.2,ranksep=.7,splines=polyline,outputorder=edgesfirst,fontname="Arial"];
node [fontname="Arial",fontsize=12,shape=plain]; edge [arrowhead=none,color="#839da8",penwidth=1.2];
"U800" [id="part-U800",class="component",tooltip="B8 / 절연 DC-DC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2f2f2" COLSPAN="2"><B>U800 · RFM-0505S</B></TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">VIN_MINUS</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">VIN_PLUS</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">VOUT_MINUS</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">VOUT_PLUS</TD></TR></TABLE>>];
"C800" [id="part-C800",class="component",tooltip="B8 / 전원 MLCC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C800 · 10u</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C801" [id="part-C801",class="component",tooltip="B8 / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C801 · 100n</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R800" [id="part-R800",class="component",tooltip="B8 / RFM 최소부하 보장",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R800 · 220R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"NT800" [id="part-NT800",class="component",tooltip="B8 / VGL 소스 기준 결합",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>NT800 · NET_TIE</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"U810" [id="part-U810",class="component",tooltip="B8 / IC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2f2f2" COLSPAN="2"><B>U810 · TPS7A1633DGNR</B></TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">OUT</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">DNC × NC</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">PG</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">GND</TD></TR><TR><TD PORT="p5" ALIGN="LEFT">5</TD><TD ALIGN="LEFT">EN</TD></TR><TR><TD PORT="p6" ALIGN="LEFT">6</TD><TD ALIGN="LEFT">NC × NC</TD></TR><TR><TD PORT="p7" ALIGN="LEFT">7</TD><TD ALIGN="LEFT">DELAY × NC</TD></TR><TR><TD PORT="p8" ALIGN="LEFT">8</TD><TD ALIGN="LEFT">IN</TD></TR><TR><TD PORT="p9" ALIGN="LEFT">9</TD><TD ALIGN="LEFT">EP_GND</TD></TR></TABLE>>];
"R810" [id="part-R810",class="component",tooltip="B8 / 로컬 PG pull-up",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R810 · 10k</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C810" [id="part-C810",class="component",tooltip="B8 / 전원 MLCC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C810 · 22u</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C811" [id="part-C811",class="component",tooltip="B8 / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C811 · 100n</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C812" [id="part-C812",class="component",tooltip="B8 / 전원 MLCC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C812 · 22u</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C813" [id="part-C813",class="component",tooltip="B8 / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C813 · 100n</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"n105" [id="n105",class="net",shape=box,style="rounded,filled",fillcolor="#d9e7f7",color="#8fa9ad",fontcolor="#28536a",label="GND",tooltip="GND"];
"n105" -> "U800":p1 [id="edge-U800-1",class="wire n105",tooltip="U800.1 = GND",style="solid"];
