"n104" [id="n104",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="F_3V3",tooltip="F_3V3"];
"n104" -> "U810":p1 [id="edge-U810-1",class="wire n104",tooltip="U810.1 = F_3V3",style="solid"];
