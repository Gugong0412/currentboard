"n63" [id="n63",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VGH1_INA_N",tooltip="/B7_VGH/VGH1_INA_N"];
