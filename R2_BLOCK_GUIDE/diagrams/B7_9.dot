"C751" [id="part-C751",class="component",tooltip="B7_VGH / 차동 입력 필터 옵션",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#fff0d5"><B>C751 · 1n · DNP</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C752" [id="part-C752",class="component",tooltip="B7_VGH / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C752 · 1u</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R757" [id="part-R757",class="component",tooltip="B7_VGH / Kelvin 션트",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f1f5f8" COLSPAN="2"><B>R757 · 3.01R</B></TD></TR><TR><TD COLSPAN="2">1↔3 / 2↔4 copper; 1–2 resistor</TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">FORCE_SRC</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">FORCE_DUT</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">SENSE_SRC</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SENSE_DUT</TD></TR></TABLE>>];
