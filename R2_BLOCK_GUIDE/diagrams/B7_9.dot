digraph G {
graph [rankdir=LR,bgcolor="white",pad=.25,nodesep=.2,ranksep=.7,splines=polyline,outputorder=edgesfirst,fontname="Arial"];
node [fontname="Arial",fontsize=12,shape=plain]; edge [arrowhead=none,color="#839da8",penwidth=1.2];
"U750" [id="part-U750",class="component",tooltip="B7_VGH / IC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2f2f2" COLSPAN="2"><B>U750 · INA228AIDGSR</B></TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">A1</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">A0</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">ALERT</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SDA</TD></TR><TR><TD PORT="p5" ALIGN="LEFT">5</TD><TD ALIGN="LEFT">SCL</TD></TR><TR><TD PORT="p6" ALIGN="LEFT">6</TD><TD ALIGN="LEFT">VS</TD></TR><TR><TD PORT="p7" ALIGN="LEFT">7</TD><TD ALIGN="LEFT">GND</TD></TR><TR><TD PORT="p8" ALIGN="LEFT">8</TD><TD ALIGN="LEFT">VBUS</TD></TR><TR><TD PORT="p9" ALIGN="LEFT">9</TD><TD ALIGN="LEFT">IN_MINUS</TD></TR><TR><TD PORT="p10" ALIGN="LEFT">10</TD><TD ALIGN="LEFT">IN_PLUS</TD></TR></TABLE>>];
"R750" [id="part-R750",class="component",tooltip="B7_VGH / 입력 필터 직렬 패드 P",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R750 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R751" [id="part-R751",class="component",tooltip="B7_VGH / 입력 필터 직렬 패드 N",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R751 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R752" [id="part-R752",class="component",tooltip="B7_VGH / ALERT pull-up",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R752 · 10k</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
