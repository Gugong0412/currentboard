{rank=sink;"U780";}
"n164" -> "n158" [constraint=false,style=dashed,color="#b37b18",label="R787 copper 1/3",fontsize=9];
"n156" -> "n157" [constraint=false,style=dashed,color="#b37b18",label="R787 copper 2/4",fontsize=9];
}