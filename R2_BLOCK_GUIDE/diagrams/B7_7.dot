"n158" [id="n158",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_LPDP_SNS_SRC",tooltip="VDDI_LPDP_SNS_SRC"];
