"C780":p1 -> "n95" [id="edge-C780-1",class="wire n95",tooltip="C780.1 = CTRL_3V3",style="solid"];
"C782":p1 -> "n95" [id="edge-C782-1",class="wire n95",tooltip="C782.1 = CTRL_3V3",style="solid"];
"n164" [id="n164",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_SRC",tooltip="VDDI_SRC"];
"n164" -> "U780":p8 [id="edge-U780-8",class="wire n164",tooltip="U780.8 = VDDI_SRC",style="solid"];
