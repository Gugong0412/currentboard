"n59" [id="n59",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_LPDP_INA_N",tooltip="/B7_VDDI_LPDP/VDDI_LPDP_INA_N"];
"n59" -> "U780":p9 [id="edge-U780-9",class="wire n59",tooltip="U780.9 = /B7_VDDI_LPDP/VDDI_LPDP_INA_N",style="solid"];
"R781":p2 -> "n59" [id="edge-R781-2",class="wire n59",tooltip="R781.2 = /B7_VDDI_LPDP/VDDI_LPDP_INA_N",style="solid"];
"C781":p2 -> "n59" [id="edge-C781-2",class="wire n59",tooltip="C781.2 = /B7_VDDI_LPDP/VDDI_LPDP_INA_N",style="dashed"];
"n60" [id="n60",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="VDDI_LPDP_INA_P",tooltip="/B7_VDDI_LPDP/VDDI_LPDP_INA_P"];
"n60" -> "U780":p10 [id="edge-U780-10",class="wire n60",tooltip="U780.10 = /B7_VDDI_LPDP/VDDI_LPDP_INA_P",style="solid"];
"R780":p2 -> "n60" [id="edge-R780-2",class="wire n60",tooltip="R780.2 = /B7_VDDI_LPDP/VDDI_LPDP_INA_P",style="solid"];
