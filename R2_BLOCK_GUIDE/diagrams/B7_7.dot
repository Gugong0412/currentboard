digraph G {
graph [rankdir=LR,bgcolor="white",pad=.25,nodesep=.2,ranksep=.7,splines=polyline,outputorder=edgesfirst,fontname="Arial"];
node [fontname="Arial",fontsize=12,shape=plain]; edge [arrowhead=none,color="#839da8",penwidth=1.2];
"U780" [id="part-U780",class="component",tooltip="B7_VDDI_LPDP / IC",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e2f2f2" COLSPAN="2"><B>U780 · INA228AIDGSR</B></TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">A1</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">A0</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">ALERT</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SDA</TD></TR><TR><TD PORT="p5" ALIGN="LEFT">5</TD><TD ALIGN="LEFT">SCL</TD></TR><TR><TD PORT="p6" ALIGN="LEFT">6</TD><TD ALIGN="LEFT">VS</TD></TR><TR><TD PORT="p7" ALIGN="LEFT">7</TD><TD ALIGN="LEFT">GND</TD></TR><TR><TD PORT="p8" ALIGN="LEFT">8</TD><TD ALIGN="LEFT">VBUS</TD></TR><TR><TD PORT="p9" ALIGN="LEFT">9</TD><TD ALIGN="LEFT">IN_MINUS</TD></TR><TR><TD PORT="p10" ALIGN="LEFT">10</TD><TD ALIGN="LEFT">IN_PLUS</TD></TR></TABLE>>];
"R780" [id="part-R780",class="component",tooltip="B7_VDDI_LPDP / 입력 필터 직렬 패드 P",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R780 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R781" [id="part-R781",class="component",tooltip="B7_VDDI_LPDP / 입력 필터 직렬 패드 N",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R781 · 0R</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R782" [id="part-R782",class="component",tooltip="B7_VDDI_LPDP / ALERT pull-up",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>R782 · 10k</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"R787" [id="part-R787",class="component",tooltip="B7_VDDI_LPDP / Kelvin 션트",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#f1f5f8" COLSPAN="2"><B>R787 · 20R</B></TD></TR><TR><TD COLSPAN="2">1↔3 / 2↔4 copper; 1–2 resistor</TD></TR><TR><TD PORT="p1" ALIGN="LEFT">1</TD><TD ALIGN="LEFT">FORCE_SRC</TD></TR><TR><TD PORT="p2" ALIGN="LEFT">2</TD><TD ALIGN="LEFT">FORCE_DUT</TD></TR><TR><TD PORT="p3" ALIGN="LEFT">3</TD><TD ALIGN="LEFT">SENSE_SRC</TD></TR><TR><TD PORT="p4" ALIGN="LEFT">4</TD><TD ALIGN="LEFT">SENSE_DUT</TD></TR></TABLE>>];
"C780" [id="part-C780",class="component",tooltip="B7_VDDI_LPDP / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C780 · 100n</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C781" [id="part-C781",class="component",tooltip="B7_VDDI_LPDP / 차동 입력 필터 옵션",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#fff0d5"><B>C781 · 1n · DNP</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"C782" [id="part-C782",class="component",tooltip="B7_VDDI_LPDP / 디커플링",label=<<TABLE BORDER="1" COLOR="#5f7e8b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD PORT="p1">1</TD><TD BGCOLOR="#f1f5f8"><B>C782 · 1u</B></TD><TD PORT="p2">2</TD></TR></TABLE>>];
"n110" [id="n110",class="net",shape=box,style="rounded,filled",fillcolor="#e7f3eb",color="#8fa9ad",fontcolor="#28536a",label="I2C1_SDA",tooltip="I2C1_SDA"];
